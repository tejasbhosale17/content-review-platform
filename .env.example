# Local sample settings only. Copy to .env (git-ignored) and change the values.
# Never commit real credentials.

MYSQL_ROOT_PASSWORD=change-me-root
CASE_DB_USER=case_user
CASE_DB_PASSWORD=change-me-case
REVIEW_DB_USER=review_user
REVIEW_DB_PASSWORD=change-me-review
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=change-me-content

# Demo HTTP Basic accounts (reporter, creator, admin)
DEMO_REPORTER_PASSWORD=change-me-reporter
DEMO_CREATOR_PASSWORD=change-me-creator
DEMO_ADMIN_PASSWORD=change-me-admin

# Kafka: host clients use localhost:19092, Compose clients use kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:19092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092
